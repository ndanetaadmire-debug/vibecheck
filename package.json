{
  "name": "vibecheck",
  "version": "1.0.0",
  "description": "Mood-based blogging with a custom, XSS-safe Markdown renderer (AST to React, no innerHTML), lexicon mood detection with negation handling, live preview and resilient drafts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
